{
 "uid": "tracing-apm",
 "title": "Game Backend — Tracing (APM)",
 "tags": [
  "game-backend"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Service graph — mapa de dependências (derivado dos traces)",
   "type": "nodeGraph",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "serviceMap"
    }
   ]
  },
  {
   "id": 2,
   "title": "Request rate por serviço (RED dos traces)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traces_spanmetrics_calls_total[5m])) by (service)",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 3,
   "title": "Latência p95 por serviço (dos traces)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le, service))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 4,
   "title": "Taxa por dependência (client → server)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traces_service_graph_request_total[5m])) by (client, server)",
     "legendFormat": "{{client}} → {{server}}"
    }
   ]
  }
 ]
}