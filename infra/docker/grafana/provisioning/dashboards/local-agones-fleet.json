{
  "title": "Local (k3d) — Agones Fleet",
  "uid": "local-agones-fleet",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "local",
    "k3d",
    "agones",
    "gameservers"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Pods Running",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{cluster=\"local\",phase=\"Running\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Node Ready",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_node_status_condition{cluster=\"local\",condition=\"Ready\",status=\"true\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - node_boot_time_seconds{cluster=\"local\",job=\"node-exporter\"}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "GameServers Ready",
      "id": 7,
      "description": "agones_fleets_replicas_count (status do CRD Fleet, reconciliado sempre) em vez de agones_gameservers_count: essa é esparsa — só existe uma série pra (fleet,type) depois que aquele estado ocorreu de fato desde que o controller subiu, então uma fleet que nunca alocou/nunca teve GameServer Ready some do painel em vez de aparecer como 0.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (agones_fleets_replicas_count{cluster=\"local\",type=\"ready\"}) or vector(0)",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "GameServers Allocated",
      "id": 8,
      "description": "agones_fleets_replicas_count (status do CRD Fleet) — mesmo motivo do painel Ready: reporta 0 de verdade por fleet, em vez de sumir quando a fleet nunca alocou.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (agones_fleets_replicas_count{cluster=\"local\",type=\"allocated\"}) or vector(0)",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "GameServers Unhealthy",
      "id": 9,
      "description": "agones_gameservers_count{type=\"Unhealthy\"} não existe pra uma fleet até ela ter um GameServer Unhealthy de verdade (esparsa, sem equivalente confiável no CRD Fleet). Complementado com um \"backfill\" de zero via agones_fleets_replicas_count (sempre presente por fleet) — o valor real sempre prevalece quando existe; o zero só entra pra fleet que nunca teve Unhealthy.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (fleet_name) (agones_gameservers_count{cluster=\"local\",type=\"Unhealthy\"} or label_replace(sum by (name) (agones_fleets_replicas_count{cluster=\"local\",type=\"desired\"}) * 0, \"fleet_name\", \"$1\", \"name\", \"(.+)\"))",
          "legendFormat": "{{fleet_name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fleet — Desired / Ready (por fleet)",
      "id": 10,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (agones_fleets_replicas_count{cluster=\"local\",type=\"desired\"}) or vector(0)",
          "legendFormat": "{{name}} desired",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (agones_fleets_replicas_count{cluster=\"local\",type=\"ready\"}) or vector(0)",
          "legendFormat": "{{name}} ready",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GameServer States",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Allocated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unhealthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Starting"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (fleet_name, type) (agones_gameservers_count{cluster=\"local\"})",
          "legendFormat": "{{fleet_name}} - {{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fleet Replicas — por fleet",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, type) (agones_fleets_replicas_count{cluster=\"local\"})",
          "legendFormat": "{{name}} - {{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU por namespace (pods)",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{cluster=\"local\",container!=\"\",container!=\"POD\"}[2m])) * 100",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAM por namespace (pods)",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (container_memory_working_set_bytes{cluster=\"local\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Pods por Namespace",
      "id": 15,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Running",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{cluster=\"local\",phase=\"Running\"})",
          "legendFormat": "{{namespace}}",
          "instant": true,
          "refId": "Running"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{cluster=\"local\",phase=\"Pending\"})",
          "legendFormat": "{{namespace}}",
          "instant": true,
          "refId": "Pending"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace": "Namespace",
              "Value #Running": "Running",
              "Value #Pending": "Pending"
            }
          }
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Uso CPU (node)",
      "id": 16,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{cluster=\"local\",job=\"node-exporter\",mode=\"idle\"}[2m])) * 100)",
          "instant": true
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Uso RAM (node)",
      "id": 17,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - node_memory_MemAvailable_bytes{cluster=\"local\",job=\"node-exporter\"} / node_memory_MemTotal_bytes{cluster=\"local\",job=\"node-exporter\"}) * 100",
          "instant": true
        }
      ]
    }
  ]
}
